generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveType {
  PAID
  SICK
  UNPAID
  CASUAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  SYSTEM
}

// ─── P2 Models (Auth / Profile / Core) ──────────────────

model User {
  id                 String         @id @default(cuid())
  clerkId            String?        @unique
  loginId            String?        @unique
  email              String         @unique
  passwordHash       String?
  role               Role           @default(EMPLOYEE)
  mustChangePassword Boolean        @default(true)
  isFirstLogin       Boolean        @default(true)
  employee           Employee?
  notifications      Notification[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Employee {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  loginId            String?        @unique
  employeeId         String?        @unique
  firstName          String
  lastName           String
  email              String?
  phone              String?
  department         String?
  designation        String?
  joinDate           DateTime?
  profilePic         String?
  address            String?
  status             EmployeeStatus @default(ACTIVE)

  basicSalary        Decimal        @default(0) @db.Decimal(10, 2)
  hra                Decimal        @default(0) @db.Decimal(10, 2)
  allowances         Decimal        @default(0) @db.Decimal(10, 2)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // P3 Relations
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  payroll            Payroll?
  payrollAnomalies   PayrollAnomaly[]
}

// ─── P3 Models (Attendance / Leave / Payroll) ───────────

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus
  hoursWorked Float?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  totalDays    Int
  reason       String
  status       LeaveStatus @default(PENDING)
  adminComment String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Payroll {
  id                String   @id @default(cuid())
  employeeId        String   @unique
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  wage              Decimal  @db.Decimal(10, 2)
  basicSalary       Decimal  @db.Decimal(10, 2)
  hra               Decimal  @db.Decimal(10, 2)
  standardAllowance Decimal  @db.Decimal(10, 2)
  performanceBonus  Decimal  @db.Decimal(10, 2)
  lta               Decimal  @db.Decimal(10, 2)
  fixedAllowance    Decimal  @db.Decimal(10, 2)
  pfEmployee        Decimal  @db.Decimal(10, 2)
  pfEmployer        Decimal  @db.Decimal(10, 2)
  professionalTax   Decimal  @db.Decimal(10, 2)
  netPayable        Decimal  @db.Decimal(10, 2)
  payableDays       Int      @default(0)
  totalWorkingDays  Int      @default(22)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SalaryConfig {
  id                   String   @id @default(cuid())
  pfEmployeeRate       Decimal  @default(0.12) @db.Decimal(5, 4)
  pfEmployerRate       Decimal  @default(0.12) @db.Decimal(5, 4)
  professionalTax      Decimal  @default(200) @db.Decimal(10, 2)
  standardAllowance    Decimal  @default(4167) @db.Decimal(10, 2)
  performanceBonusRate Decimal  @default(0.0833) @db.Decimal(5, 4)
  ltaRate              Decimal  @default(0.0833) @db.Decimal(5, 4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
}

// ─── Enterprise HRMS Models (Audit & Anomalies) ─────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model PayrollAnomaly {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollId   String?
  ruleCode    String
  severity    AnomalySeverity @default(MEDIUM)
  title       String
  description String
  details     Json?
  isResolved  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([employeeId])
  @@index([ruleCode])
  @@index([isResolved])
}
